{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cells",
  "version": "1.1.1",
  "identifier": "com.laki.cells",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cells - Spreadsheet Editor",
        "width": 1320,
        "height": 840,
        "minWidth": 640,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 17
        },
        "transparent": true,
        "windowEffects": {
          "effects": [
            "sidebar"
          ],
          "state": "followsWindowActiveState"
        }
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "fileAssociations": [
      {
        "ext": [
          "csv",
          "tsv"
        ],
        "name": "CSV document",
        "role": "Editor",
        "mimeType": "text/csv"
      },
      {
        "ext": [
          "xlsx",
          "xlsm",
          "xls",
          "xlsb",
          "ods"
        ],
        "name": "Spreadsheet",
        "role": "Editor"
      },
      {
        "ext": [
          "gsheet"
        ],
        "name": "Google Sheets shortcut",
        "role": "Viewer"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "files": {
        "Resources/Assets.car": "icons/Assets.car"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc0RTczMzVDQTk5MUQ0MkQKUldRdDFKR3BYRFBuZEYyMlJiRnpRNFdJVmFlYVpJYllMSkFOQ0tBbTNlYWw1cjU3ZE9Ed3VrSkcK",
      "endpoints": [
        "https://github.com/lakiAlex/cells/releases/latest/download/latest.json"
      ]
    }
  }
}
